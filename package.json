{
  "name": "entry-next",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev apps/web",
    "build": "npm run db:deploy && cd apps/web && next build --webpack",
    "start": "next start apps/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/agent/tsconfig.json",
    "postinstall": "(cd packages/db && node ../../node_modules/prisma/build/index.js generate) && node scripts/patch-engines.js && npx --yes patch-package",
    "db:migrate": "(cd packages/db && node ../../node_modules/prisma/build/index.js migrate dev)",
    "db:deploy": "node packages/db/scripts/run-production-migrate.js",
    "db:studio": "(cd packages/db && node ../../node_modules/prisma/build/index.js studio)"
  },
  "dependencies": {
    "ai": "^7.0.31",
    "better-auth": "^1.6.23",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "@hono/node-server": "^1.19.13",
    "@blocksuite/icons": "file:patches/blocksuite-icons-patched.tgz",
    "glob": "^13.0.6",
    "sharp": "^0.35.3",
    "tar": "^7.5.22",
    "valibot": "^1.4.2",
    "brace-expansion": "^5.0.8",
    "fast-uri": "^3.1.4",
    "find-my-way": "^9.7.0"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "cbor-extract@2.2.2": true
  }
}
